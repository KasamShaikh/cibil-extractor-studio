# Copy to .env and fill in. Auth is keyless (DefaultAzureCredential / workload or
# managed identity) — no keys or secrets here, only resource endpoints.

# Azure AI Document Intelligence (prebuilt-layout) endpoint:
DI_ENDPOINT=https://<your-doc-intelligence>.cognitiveservices.azure.com/

# Azure OpenAI (Microsoft Foundry) model:
FOUNDRY_ENDPOINT=https://<your-openai-account>.openai.azure.com/
FOUNDRY_DEPLOYMENT=gpt-5.4-mini
FOUNDRY_API_VERSION=2025-04-01-preview
FOUNDRY_REGION=South India
FOUNDRY_REASONING=true
