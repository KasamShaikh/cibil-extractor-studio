# Copy to terraform.tfvars and set your subscription id.
# With create_ai = true (default) this provisions everything from scratch, so the
# subscription id is the only value you must provide.
subscription_id = "00000000-0000-0000-0000-000000000000"

# Optional overrides (defaults shown):
# location         = "centralindia"
# foundry_location = "southindia"      # region that offers the model
# model_name       = "gpt-5.4-mini"
# model_version    = "2026-03-17"
# github_repo      = "your-org/cibil-extractor-studio"

# --- To REUSE existing Azure AI and an existing resource group instead: ---
# create_ai             = false
# resource_group_name   = "your-existing-rg"
# existing_di_name      = "your-doc-intelligence-account"
# existing_foundry_name = "your-openai-or-foundry-account"
# foundry_deployment    = "gpt-5.4-mini"
