# Copy this file to terraform.tfvars and set your subscription id.
# That subscription id is the ONLY value you must provide.
subscription_id = "00000000-0000-0000-0000-000000000000"

# Optional overrides (defaults shown):
# location         = "centralindia"          # AKS / ACR / Document Intelligence
# foundry_location = "southindia"             # Azure OpenAI account (must offer the model)
# model_name       = "gpt-5.4-mini"
# model_version    = "2026-03-17"
# model_capacity   = 50
# github_repo      = "your-org/cibil-extractor-studio"
# aks_node_count   = 1
# aks_node_size    = "Standard_D2s_v3"
